# ================================================================
# 단타 RSI 신호 시스템 - KIS 정시 알림용 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 KIS 키만 입력하면 됩니다.
# .env 는 .gitignore 대상이며 GitHub에 올리면 안 됩니다.
#
# 텔레그램은 기존 단타RSI신호시스템 설정을 그대로 사용합니다.
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID를 새로 만들 필요가 없습니다.
# 기존 Windows 환경변수 또는 .streamlit/secrets.toml 값이 사용됩니다.
# ================================================================

# [필수] 한국투자증권 Open API
KIS_APP_KEY=여기에_한국투자증권_APP_KEY
KIS_APP_SECRET=여기에_한국투자증권_APP_SECRET
KIS_ENV=real

# [기존 텔레그램 설정 - 새로 입력하지 않아도 기존 환경값 사용]
# TELEGRAM_BOT_TOKEN=기존값
# TELEGRAM_CHAT_ID=기존값

# [권장] Streamlit의 swing_positions.json과 로컬 알림 봇 상태 동기화
GITHUB_TOKEN=github_pat_여기에_입력
GITHUB_REPO=본인계정/저장소이름

# [기존 전략값]
INTERVAL=30m
RSI_BUY=30
RSI_SELL=70
SEED=3000000
KOSPI_N=100
KOSDAQ_N=10
KOSDAQ_LIMIT=5

# [KIS 정시 실행]
KIS_CLOSE_DELAY_SEC=4
KIS_ALERT_GRACE_SEC=60
KIS_CALLS_PER_SECOND=3
KIS_WORKERS=1
KIS_HISTORY_BARS=50
KIS_AUTO_BOOTSTRAP=1
KIS_RATE_LIMIT_COOLDOWN_SEC=2
